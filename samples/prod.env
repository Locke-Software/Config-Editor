API_URL=https://api.example.com
API_TIMEOUT_MS=5000
API_RETRY_COUNT=3
LOG_LEVEL=warn
LOG_FORMAT=json
MAX_CONNECTIONS=100
CACHE_ENABLED=true
FEATURE_FLAG_NEW_UI=false
FEATURE_FLAG_BETA_SEARCH=false
DATABASE_PORT=5432
DATABASE_HOST=prod-db.internal
DATABASE_NAME=app_prod
database.pool.max=50
SESSION_SECRET=prod-secret-should-be-vault-managed
RATE_LIMIT_PER_MINUTE=100
CDN_URL=https://cdn.example.com
server.host=0.0.0.0
server.port=8080
server.workers=8
server.requestTimeoutMs=15000
security.corsAllowedOrigins=https://app.example.com
security.jwtExpiryMinutes=30
security.passwordMinLength=10
security.mfaEnabled=true
smtp.host=smtp.example.com
smtp.port=587
smtp.username=prod-mailer
smtp.useTls=true
storage.provider=s3
storage.bucket=prod-uploads
storage.region=us-west-2
redis.port=6379
redis.host=prod-redis.internal
redis.ttlSeconds=600
monitoring.metricsEnabled=true
monitoring.tracingSampleRate=0.01
monitoring.alertWebhookUrl=https://hooks.example.com/alerts
queue.workerConcurrency=8
queue.maxRetries=5
queue.visibilityTimeoutSeconds=60
pagination.defaultPageSize=20
pagination.maxPageSize=100
i18n.defaultLocale=en-US
i18n.supportedLocales=en-US,fr-FR,es-ES,de-DE
throttling.requestsPerMinute=3000
throttling.burst=200
search.provider=opensearch
search.indexName=prod_index
search.timeoutMs=1500
analytics.enabled=true
analytics.writeKey=prod-write-key
