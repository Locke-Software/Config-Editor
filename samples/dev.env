API_URL=https://dev.api.example.com
API_TIMEOUT_MS=3000
API_RETRY_COUNT=2
LOG_LEVEL=debug
LOG_FORMAT=pretty
MAX_CONNECTIONS=5
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
FEATURE_FLAG_NEW_UI=true
FEATURE_FLAG_BETA_SEARCH=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app_dev
database.pool.min=2
database.pool.max=10
SESSION_SECRET=dev-secret-change-me
RATE_LIMIT_PER_MINUTE=1000
server.host=0.0.0.0
server.port=8080
server.workers=2
server.requestTimeoutMs=30000
security.corsAllowedOrigins=*
security.jwtExpiryMinutes=60
security.passwordMinLength=8
security.mfaEnabled=false
smtp.host=smtp.mailtrap.io
smtp.port=2525
smtp.username=dev-mailer
smtp.useTls=false
storage.provider=local
storage.bucket=dev-uploads
storage.region=us-east-1
redis.host=localhost
redis.port=6379
redis.ttlSeconds=300
monitoring.metricsEnabled=false
monitoring.tracingSampleRate=0.1
monitoring.alertWebhookUrl=
queue.workerConcurrency=2
queue.maxRetries=3
queue.visibilityTimeoutSeconds=30
pagination.defaultPageSize=20
pagination.maxPageSize=100
i18n.defaultLocale=en-US
i18n.supportedLocales=en-US,fr-FR
throttling.requestsPerMinute=600
throttling.burst=50
search.provider=local
search.indexName=dev_index
search.timeoutMs=2000
analytics.enabled=false
analytics.writeKey=
