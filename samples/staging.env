API_URL=https://staging.api.example.com
API_TIMEOUT_MS=3000
API_RETRY_COUNT=3
LOG_FORMAT=json
LOG_LEVEL=info
MAX_CONNECTIONS=20
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
FEATURE_FLAG_NEW_UI=true
DATABASE_HOST=staging-db.internal
DATABASE_PORT=5432
DATABASE_NAME=app_staging
database.pool.max=20
database.pool.min=5
SESSION_SECRET=staging-secret-change-me
RATE_LIMIT_PER_MINUTE=500
server.host=0.0.0.0
server.port=8080
server.workers=4
server.requestTimeoutMs=30000
security.corsAllowedOrigins=https://staging.example.com
security.jwtExpiryMinutes=60
security.passwordMinLength=8
security.mfaEnabled=true
smtp.host=smtp.staging.example.com
smtp.port=587
smtp.username=staging-mailer
smtp.useTls=true
storage.provider=s3
storage.bucket=staging-uploads
storage.region=us-east-1
redis.host=staging-redis.internal
redis.port=6379
redis.ttlSeconds=300
monitoring.metricsEnabled=true
monitoring.tracingSampleRate=0.25
queue.workerConcurrency=4
queue.maxRetries=3
queue.visibilityTimeoutSeconds=30
pagination.defaultPageSize=20
pagination.maxPageSize=100
i18n.defaultLocale=en-US
i18n.supportedLocales=en-US,fr-FR
throttling.requestsPerMinute=1200
throttling.burst=100
search.provider=opensearch
search.indexName=staging_index
search.timeoutMs=2000
analytics.enabled=true
analytics.writeKey=staging-write-key
